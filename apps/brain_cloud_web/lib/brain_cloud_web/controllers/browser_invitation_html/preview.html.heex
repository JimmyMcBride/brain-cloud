<Layouts.app flash={@flash}>
  <section class="mx-auto max-w-lg space-y-6">
    <h1 class="text-4xl font-semibold tracking-tight">Join {@invitation.organization.name}</h1>
    <p>
      Invited as <strong class="break-all">{@invitation.email}</strong>, with the member role.
    </p>
    <p>
      Joining creates your membership. It does not verify your email or sign you in. No API credential is issued.
    </p>
    <form action={~p"/invitations/accept"} method="post">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input type="hidden" name="invitation[token]" value={@token} />
      <button class="rounded-full bg-slate-950 px-6 py-3 font-semibold text-white">Join organization</button>
    </form>
  </section>
</Layouts.app>
