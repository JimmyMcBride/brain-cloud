<Layouts.app flash={@flash}>
  <section class="mx-auto max-w-3xl space-y-8">
    <header class="space-y-3 border-b border-slate-200 pb-6">
      <.link href={~p"/"} class="text-sm text-cyan-700 underline">Back to your organization</.link>
      <h1 class="text-4xl font-semibold tracking-tight text-slate-950">Invite a member</h1>
      <p class="text-slate-600">
        Invite someone to {@current_scope.organization.name}. They review the invitation, join, then sign in with email.
      </p>
    </header>
    <form action={~p"/organization/invitations"} method="post" class="space-y-5">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <label class="block">Email<input
        type="email"
        name="invitation[email]"
        required
        maxlength="254"
        class="mt-2 block w-full rounded border border-slate-300 p-3"
      /></label>
      <label class="block">Display name<input
        name="invitation[display_name]"
        required
        maxlength="120"
        class="mt-2 block w-full rounded border border-slate-300 p-3"
      /></label>
      <p class="text-sm text-slate-600">
        Member role · expires in seven days · no project access granted. Browser joining issues no API credential. API acceptance permits only memory reading and keyword search, subject to project access.
      </p>
      <button class="rounded-full bg-slate-950 px-6 py-3 font-semibold text-white">Send invitation</button>
    </form>
    <section class="space-y-4" aria-labelledby="pending-title">
      <h2 id="pending-title" class="text-2xl font-semibold">Unresolved invitations</h2>
      <p class="text-sm text-slate-600">
        Resending invalidates every older link, including manually copied API acceptance secrets. Expiry stays unchanged. Revoke an expired invitation before replacing it.
      </p>
      <p :if={@invitations == []} class="py-6 text-slate-500">No invitations waiting.</p>
      <article :for={invitation <- @invitations} class="space-y-3 border-t border-slate-200 py-5">
        <h3 class="break-all font-semibold">{invitation.email}</h3>
        <p class="text-sm text-slate-600">
          {BrainCloud.Accounts.OrganizationInvitation.status(invitation)} · email: {invitation.delivery_state} · expires {DateTime.to_iso8601(
            invitation.expires_at
          )}
        </p>
        <div class="flex flex-wrap gap-3">
          <form
            :if={BrainCloud.Accounts.OrganizationInvitation.status(invitation) == "pending"}
            action={~p"/organization/invitations/#{invitation.id}/send"}
            method="post"
          >
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button class="rounded border border-slate-300 px-4 py-2">Send new link</button>
          </form>
          <form action={~p"/organization/invitations/#{invitation.id}"} method="post">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <input type="hidden" name="_method" value="delete" />
            <button class="rounded border border-rose-200 px-4 py-2 text-rose-700">Revoke</button>
          </form>
        </div>
      </article>
    </section>
  </section>
</Layouts.app>
