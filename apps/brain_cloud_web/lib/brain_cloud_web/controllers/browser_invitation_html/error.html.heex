<Layouts.app flash={@flash}>
  <section class="mx-auto max-w-lg space-y-6">
    <h1 class="text-3xl font-semibold">Invitation could not continue</h1>
    <p role="alert">{@message}</p>
    <.link href={~p"/"} class="text-cyan-700 underline">Return to Brain Cloud</.link>
    <form :if={@current_scope} action={~p"/session"} method="post">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input type="hidden" name="_method" value="delete" />
      <button class="rounded border border-slate-300 px-4 py-2">Sign out</button>
    </form>
  </section>
</Layouts.app>
